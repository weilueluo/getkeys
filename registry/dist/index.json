            "placeholder": "AKIA…",
            "required": true,
            "secret": false,
            "env": "AWS_ACCESS_KEY_ID"
          },
          {
            "key": "secret_access_key",
            "label": "Secret access key",
            "placeholder": "Paste the secret",
            "required": true,
            "secret": true,
            "env": "AWS_SECRET_ACCESS_KEY"
          },
          {
            "key": "session_token",
            "label": "Session token",
            "placeholder": "Only for temporary credentials",
            "required": false,
            "secret": true,
            "env": "AWS_SESSION_TOKEN"
          },
          {
            "key": "region",
            "label": "Region",
            "placeholder": "",
            "required": false,
            "secret": false,
            "env": "AWS_REGION"
          },
          {
            "key": "account_id",
            "label": "Account ID",
            "placeholder": "",
            "required": false,
            "secret": false,
            "env": ""
