{
  "version": 1,
  "packages": [
    {
      "manifest": {
        "id": "official.aws",
        "name": "AWS",
        "publisher": "getkeys",
        "version": "0.1.0",
        "api_version": 1,
        "description": "Sign in with IAM Identity Center and manage IAM access keys.",
        "homepage": "https://aws.amazon.com",
        "hosts": [
          "iam.amazonaws.com",
          "sts.amazonaws.com"
        ],
        "auth": {
          "kind": "aws_sso"
        },
        "operations": [
          "identity",
          "list_resources",
          "list_credentials",
          "create_credential",
          "validate_credential",
          "deactivate_credential",
          "revoke_credential"
        ],
        "fields": [
          {
            "key": "start_url",
            "label": "IAM Identity Center start URL",
            "placeholder": "https://your-company.awsapps.com/start",
            "required": true,
            "secret": false,
            "env": ""
          },
          {
            "key": "region",
            "label": "SSO region",
            "placeholder": "eu-west-2",
            "required": true,
            "secret": false,
            "env": ""
          }
        ],
        "credential_fields": [
          {
            "key": "access_key_id",
            "label": "Access key ID",
            "placeholder": "AKIA…",
            "required": true,
            "secret": false,
            "env": "AWS_ACCESS_KEY_ID"
          },
          {
            "key": "secret_access_key",
            "label": "Secret access key",
            "placeholder": "Paste the secret value",
            "required": true,
            "secret": true,
            "env": "AWS_SECRET_ACCESS_KEY"
          },
          {
            "key": "session_token",
            "label": "Session token",
            "placeholder": "Only for temporary credentials",
            "required": false,
            "secret": true,
            "env": "AWS_SESSION_TOKEN"
          }
        ],
        "account_fields": [
          {
            "key": "access_key_id",
            "label": "Access key ID",
            "placeholder": "AKIA…",
            "required": true,
            "secret": false,
            "env": "AWS_ACCESS_KEY_ID"
          },
          {
            "key": "secret_access_key",
            "label": "Secret access key",
            "placeholder": "Paste the secret",
            "required": true,
            "secret": true,
            "env": "AWS_SECRET_ACCESS_KEY"
          },
          {
            "key": "session_token",
            "label": "Session token",
            "placeholder": "Only for temporary credentials",
            "required": false,
            "secret": true,
            "env": "AWS_SESSION_TOKEN"
          },
          {
            "key": "region",
            "label": "Region",
            "placeholder": "",
            "required": false,
            "secret": false,
            "env": "AWS_REGION"
          },
          {
            "key": "account_id",
            "label": "Account ID",
            "placeholder": "",
            "required": false,
            "secret": false,
            "env": ""
          }
        ],
        "token_page": "https://console.aws.amazon.com/iam/home#/security_credentials",
        "account_credentials": false
      },
      "wasm": "official.aws-0.1.0.wasm",
      "sha256": "e25dfbebc5f7b3b7708c72af26f0e513161a9c790d5351d0cb1beb421938d941"
