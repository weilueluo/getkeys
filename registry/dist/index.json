    {
      "manifest": {
        "id": "official.github",
        "name": "GitHub",
        "publisher": "getkeys",
        "version": "0.1.0",
        "api_version": 1,
        "description": "Connect repositories, store tokens, and update Actions secrets.",
        "homepage": "https://github.com",
        "hosts": [
          "api.github.com",
          "github.com"
        ],
        "auth": {
          "kind": "device",
          "device_url": "https://github.com/login/device/code",
          "token_url": "https://github.com/login/oauth/access_token",
          "client_id_env": "GETKEYS_GITHUB_CLIENT_ID",
          "scopes": "repo read:user"
        },
        "operations": [
          "identity",
          "list_resources",
          "validate_credential",
          "write_secret",
          "guide"
        ],
        "fields": [],
        "credential_fields": [
          {
            "key": "token",
            "label": "Personal access token",
            "placeholder": "github_pat_…",
            "required": true,
            "secret": true,
            "env": "GITHUB_TOKEN"
          }
        ],
        "account_fields": [
          {
            "key": "token",
            "label": "Token",
            "placeholder": "ghp_…",
            "required": true,
            "secret": true,
            "env": "GITHUB_TOKEN"
          }
        ],
        "token_page": "https://github.com/settings/tokens/new?description=GetKeys&scopes=repo,read:user",
        "account_credentials": false
      },
      "wasm": "official.github-0.1.0.wasm",
      "sha256": "e6ec6947f3cccbfad402eadfd3ab85a95b8d5bdfa6a22c4fe12a55371a02137a"
