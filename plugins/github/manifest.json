{
  "id": "official.github",
  "name": "GitHub",
  "publisher": "getkeys",
  "version": "0.2.0",
  "description": "Make fine-grained GitHub tokens on a filled-in page, and revoke them for you.",
  "homepage": "https://github.com",
  "category": "devtools",
  "hosts": ["api.github.com", "github.com"],
  "auth": {
    "kind": "device",
    "device_url": "https://github.com/login/device/code",
    "token_url": "https://github.com/login/oauth/access_token",
    "client_id_env": "GETKEYS_GITHUB_CLIENT_ID",
    "scopes": "repo read:user"
  },
  "operations": ["identity", "list_resources", "validate_credential", "revoke_credential", "guide"],
  "fields": [],
  "credential_fields": [
    {
      "key": "token",
      "label": "Personal access token",
      "placeholder": "github_pat_…",
      "required": true,
      "env": "GITHUB_TOKEN"
    }
  ],
  "account_fields": [
    {
      "key": "token",
      "label": "Token",
      "placeholder": "ghp_…",
      "required": true,
      "env": "GITHUB_TOKEN"
    }
  ],
  "token_page": "https://github.com/settings/tokens/new?description=GetKeys&scopes=repo,read:user",
  "account_keys": true,
  "key_page": "https://github.com/settings/personal-access-tokens/new?name={name}&description=Made%20with%20GetKeys&target_name={owner}&expires_in=90&contents=write&pull_requests=write&issues=write",
  "revoke_by_value": true,
  "key_pattern": "^(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,})$",
  "validate": { "url": "https://api.github.com/user" },
  "sources": [
    { "kind": "gh_cli", "label": "GitHub CLI" },
    { "kind": "env", "var": "GH_TOKEN" },
    { "kind": "env", "var": "GITHUB_TOKEN" }
  ]
}
