{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GetKeys",
  "version": "0.2.0",
  "identifier": "dev.getkeys.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GetKeys",
        "width": 1160,
        "height": 780,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["getkeys"] } } },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "../../../registry/dist/": "registry/" },
    "windows": { "nsis": { "installerHooks": "windows/hooks.nsh" } },
    "macOS": { "signingIdentity": "-" }
  }
}
