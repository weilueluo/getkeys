{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GetKeys",
  "version": "0.1.0",
  "identifier": "dev.getkeys.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "GetKeys", "width": 1160, "height": 780, "minWidth": 800, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "resources": { "../../../registry/dist/": "registry/" } }
}
